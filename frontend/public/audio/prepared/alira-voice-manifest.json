  "assets": [
    {
      "group": "initial",
      "key": "26e0b8021d4a5d55f10aee94ef86e4fdd80a93948b658a4d76f68e1d6ffe8fc4",
      "url": "/audio/prepared/26e0b8021d4a5d55f10aee94ef86e4fdd80a93948b658a4d76f68e1d6ffe8fc4.mp3",
      "bytes": 118326,
      "text": "Welcome. Sit upright with your affected hand on your lap. Slowly lift that hand forward to the first circle."
    },
    {
      "group": "initial",
      "key": "98095839a746794fbc6df4a0d036a0fd57c32f35b12fb8dbbb243f36dbff8e90",
      "url": "/audio/prepared/98095839a746794fbc6df4a0d036a0fd57c32f35b12fb8dbbb243f36dbff8e90.mp3",
      "bytes": 149673,
      "text": "Now, slowly reach your affected arm forward, as far as you comfortably can, toward the bright circle in front of you. Keep your back straight and stay relaxed."
    },
    {
      "group": "initial",
      "key": "0e9670bb82c96d9066e25d29a122d9dd07ea8866d1e0db379fa0c4b27ce272e9",
      "url": "/audio/prepared/0e9670bb82c96d9066e25d29a122d9dd07ea8866d1e0db379fa0c4b27ce272e9.mp3",
      "bytes": 58140,
      "text": "Hold your hand steadily at the forward target for a moment."
    },
    {
      "group": "initial",
      "key": "c7d2e8c49464c1460f0e6e54e545cecc0293c27e418fd3a0391c639322cfcca5",
      "url": "/audio/prepared/c7d2e8c49464c1460f0e6e54e545cecc0293c27e418fd3a0391c639322cfcca5.mp3",
      "bytes": 75276,
      "text": "Wonderful effort. Slowly bring your affected hand back to your lap."
    },
    {
      "group": "initial",
      "key": "e9e4c37eb4e30048af050f0bc8fce625599bf4438a074efa9be4d739f2a44552",
      "url": "/audio/prepared/e9e4c37eb4e30048af050f0bc8fce625599bf4438a074efa9be4d739f2a44552.mp3",
      "bytes": 108713,
      "text": "Let's bring your affected hand toward your mouth. First, lift it from your lap toward the circle at your chest."
    },
    {
      "group": "initial",
      "key": "57e66698862870c3aa162ab2c07723369d3d1c7195b0096ced92e01e2a3fa284",
      "url": "/audio/prepared/57e66698862870c3aa162ab2c07723369d3d1c7195b0096ced92e01e2a3fa284.mp3",
      "bytes": 106623,
      "text": "Now, slowly bring your hand up to your mouth, as if you were drinking from a cup. Keep your head still."
    },
    {
      "group": "initial",
      "key": "5f00dd47b73190411bf9bbed99420ca7f764234873477095dd70648ce0ed0827",
      "url": "/audio/prepared/5f00dd47b73190411bf9bbed99420ca7f764234873477095dd70648ce0ed0827.mp3",
      "bytes": 58976,
      "text": "Hold your affected hand steadily at your mouth for a moment."
    },
    {
      "group": "initial",
      "key": "2b5b3381638713e9487f6922f643d0bf92aad8c308c97c3764c90f2c3bd32599",
      "url": "/audio/prepared/2b5b3381638713e9487f6922f643d0bf92aad8c308c97c3764c90f2c3bd32599.mp3",
      "bytes": 51035,
      "text": "Great job. Lower your affected hand back to your lap."
    },
    {
      "group": "initial",
      "key": "a4563d5918386b519b2d24076d768884c9693b2c60d2dd28dd58b8a7b2dd90df",
      "url": "/audio/prepared/a4563d5918386b519b2d24076d768884c9693b2c60d2dd28dd58b8a7b2dd90df.mp3",
      "bytes": 56050,
      "text": "Open your hand wide and show your palm to the camera."
    },
    {
      "group": "initial",
      "key": "9b75df548fe7a116d7e3720a6ad6199509efef15b5da35d1a61ec8254d1891db",
      "url": "/audio/prepared/9b75df548fe7a116d7e3720a6ad6199509efef15b5da35d1a61ec8254d1891db.mp3",
      "bytes": 78202,
      "text": "Now close your hand gently, then open it again. Move slowly and smoothly."
    },
    {
      "group": "initial",
      "key": "43ba8fc1e2cc9b1511cc353426f4ed01d7460c7630972449bc4bbcb1d4d796d8",
      "url": "/audio/prepared/43ba8fc1e2cc9b1511cc353426f4ed01d7460c7630972449bc4bbcb1d4d796d8.mp3",
      "bytes": 69425,
      "text": "Well done. Lower your affected hand to the same place on your lap."
    },
    {
      "group": "initial",
      "key": "a33a45de7a66d52d230d324d709ff2b3c7c4efc663c8742c1c109fa4ab2ef15c",
      "url": "/audio/prepared/a33a45de7a66d52d230d324d709ff2b3c7c4efc663c8742c1c109fa4ab2ef15c.mp3",
      "bytes": 71515,
      "text": "Bring your hand up in front of your chest, palm facing you or the camera."
    },
    {
      "group": "initial",
      "key": "cdf12a53a563049d6769d26c65980367cd11b3092b4ac7380618d16dc9567ea0",
      "url": "/audio/prepared/cdf12a53a563049d6769d26c65980367cd11b3092b4ac7380618d16dc9567ea0.mp3",
      "bytes": 107877,
      "text": "Touch the tip of your thumb to the tip of your index finger, as if pinching a small coin. Hold it steady."
    },
    {
      "group": "initial",
      "key": "77fa65ab5fbb7fe493dd2dfe110eacda346f20476cdfb19b7149a96821ad9294",
      "url": "/audio/prepared/77fa65ab5fbb7fe493dd2dfe110eacda346f20476cdfb19b7149a96821ad9294.mp3",
      "bytes": 79874,
      "text": "Separate your fingers, then lower your affected hand to the same place on your lap."
    },
    {
      "group": "initial",
      "key": "63aa8ae99c45630736820af31cff3178ea5b5a51c7b7778c8e81b0a2a9ad656a",
      "url": "/audio/prepared/63aa8ae99c45630736820af31cff3178ea5b5a51c7b7778c8e81b0a2a9ad656a.mp3",
      "bytes": 379968,
      "text": "For this final walking record, ask a carer or family member to take a short video from the front while you walk toward the camera at your usual comfortable pace. Keep your whole body and usual walking aid visible when possible. A fixed camera is best. If the route does not fit, the recorder may move smoothly from a safe position beside the path, but must not walk backward in front of you."
    },
    {
      "group": "initial",
      "key": "e36149510a673c042506f6b45ff49b041e94b106b8030dc8b29a239e35d5edb3",
      "url": "/audio/prepared/e36149510a673c042506f6b45ff49b041e94b106b8030dc8b29a239e35d5edb3.mp3",
      "bytes": 140896,
      "text": "Walk toward the camera at your usual comfortable pace for a few natural steps. Do not walk faster or farther than feels safe."
    },
    {
      "group": "initial",
      "key": "e97b8ee5f90620b79b171ed342c7e07a620327f703c195662f21ea932758637f",
      "url": "/audio/prepared/e97b8ee5f90620b79b171ed342c7e07a620327f703c195662f21ea932758637f.mp3",
      "bytes": 78202,
      "text": "Stop in a safe position. The short frontal walking video is ready to upload."
    },
    {
      "group": "initial",
      "key": "840870439cde917cfb6649c748529b49b7d4b91b7bcd7f067dc95491dd90bd23",
      "url": "/audio/prepared/840870439cde917cfb6649c748529b49b7d4b91b7bcd7f067dc95491dd90bd23.mp3",
      "bytes": 159286,
      "text": "The walking video is saved as part of your assessment record. Thank you. Your survey identifies the affected area and side, and your assessment is now complete."
    },
    {
      "group": "initial",
      "key": "6b1d256dd92c93de4efe14f67b063415cc5b93752bd35f26c30ef35675798c2b",
      "url": "/audio/prepared/6b1d256dd92c93de4efe14f67b063415cc5b93752bd35f26c30ef35675798c2b.mp3",
      "bytes": 74022,
      "text": "We could not confirm the face in this video. You can still use it for this test."
    },
    {
      "group": "initial",
      "key": "00d248d357ff87c98f4a7f39f82fb8ccf9293769b88e992f48ea04c707e59abf",
      "url": "/audio/prepared/00d248d357ff87c98f4a7f39f82fb8ccf9293769b88e992f48ea04c707e59abf.mp3",
      "bytes": 91159,
      "text": "We could not confirm the face in this video. The video will be included and marked for therapist review."
    },
    {
      "group": "initial",
      "key": "fd7b50509ebb5c266e20dd53c6dcacb4c36609ebf712a5d94614e95c8e96e7a2",
      "url": "/audio/prepared/fd7b50509ebb5c266e20dd53c6dcacb4c36609ebf712a5d94614e95c8e96e7a2.mp3",
      "bytes": 100772,
      "text": "That is okay. We will skip walking today and mark it as not observed, not as a failed test."
    },
    {
      "group": "initial",
      "key": "3838d7d9702a7196652f1df38a865ebcbee7ecea31cf1d74efc190b164064842",
      "url": "/audio/prepared/3838d7d9702a7196652f1df38a865ebcbee7ecea31cf1d74efc190b164064842.mp3",
      "bytes": 289271,
      "text": "Before we begin, sit still with your affected hand resting on the visible part of your lap. Keep your face, shoulders, affected arm, and the top of your affected thigh in view. You do not need to show your knees or your full lap. I will locate your lap target for the assessment."
    },
    {
      "group": "initial",
      "key": "a2e18f6887c6ede09192fd2d6713278ed76b47c2d4394890c0a6d636d0f40c88",
      "url": "/audio/prepared/a2e18f6887c6ede09192fd2d6713278ed76b47c2d4394890c0a6d636d0f40c88.mp3",
      "bytes": 262522,
      "text": "Rest your affected hand on your lap where the camera can see it. Hold it still for two seconds. Keep your face, both shoulders, affected arm, and both hips in view for the movement and trunk lean checks. You can tilt the camera instead of moving farther away."
    },
    {
      "group": "initial",
      "key": "57e9eda86fb9030a50a7a7338d304e0f1657e3c33b16be6e5745dec7eb7ccca7",
      "url": "/audio/prepared/57e9eda86fb9030a50a7a7338d304e0f1657e3c33b16be6e5745dec7eb7ccca7.mp3",
      "bytes": 117072,
      "text": "Calibration complete. Stay seated in this position and do not move the camera. We will begin the assessment now."
    },
    {
      "group": "initial",
      "key": "68140b9c2d5f65b88929941059e69207246cb06a5c50bf15cd58498604c8172b",
      "url": "/audio/prepared/68140b9c2d5f65b88929941059e69207246cb06a5c50bf15cd58498604c8172b.mp3",
      "bytes": 92413,
      "text": "Wonderful work! You did beautifully. Take a breath, the next task is on its way."
    },
    {
      "group": "initial",
      "key": "c4f72d7f12ad77075d9ec47c6ac13fcbe376190b8020f8e2f15386ea210c8fc9",
      "url": "/audio/prepared/c4f72d7f12ad77075d9ec47c6ac13fcbe376190b8020f8e2f15386ea210c8fc9.mp3",
      "bytes": 73186,
      "text": "Amazing effort! I'm so proud of you. Let's keep this momentum going."
    },
    {
      "group": "initial",
      "key": "979dca47d826628e4ce4542656d7dbf3c998865361e7701134c7fecac83d0eb5",
      "url": "/audio/prepared/979dca47d826628e4ce4542656d7dbf3c998865361e7701134c7fecac83d0eb5.mp3",
      "bytes": 60648,
      "text": "Brilliant! That was excellent. You're making real progress."
    },
    {
      "group": "initial",
      "key": "49a72ae688745e0f0004cef68bb9a188508bb08f8b346d7f1bf3d63b2aa9901b",
      "url": "/audio/prepared/49a72ae688745e0f0004cef68bb9a188508bb08f8b346d7f1bf3d63b2aa9901b.mp3",
      "bytes": 74440,
      "text": "Magnificent! Every movement counts. You're doing incredibly well."
    },
    {
      "group": "initial",
      "key": "51181a3ac132d45c80a9082060d749eaa2f3ade54d42097be903722e10f150e1",
      "url": "/audio/prepared/51181a3ac132d45c80a9082060d749eaa2f3ade54d42097be903722e10f150e1.mp3",
      "bytes": 52288,
      "text": "Bravo! Beautiful control. Onward to the next."
    },
    {
      "group": "initial",
      "key": "932ab0de038e6f564edfc3324043c1a38bc9a74210847958f6861c94b7084c44",
      "url": "/audio/prepared/932ab0de038e6f564edfc3324043c1a38bc9a74210847958f6861c94b7084c44.mp3",
      "bytes": 72351,
      "text": "Excellent! That's the spirit. One step closer to recovery."
    },
    {
      "group": "assessment:upper_limb",
      "key": "78e71f617c3af9c842c7ed00884f305a3c3c961d57dc694bd6e43c790b5e5f07",
      "url": "/audio/prepared/78e71f617c3af9c842c7ed00884f305a3c3c961d57dc694bd6e43c790b5e5f07.mp3",
      "bytes": 84889,
      "text": "Next, raise your affected arm from your side toward the first circle at mid height."
    },
    {
      "group": "assessment:upper_limb",
      "key": "f8d6c4ed5e618f688e75e81d4ef58f78e53e8cfc17851854e8ff89c2ae6fc112",
      "url": "/audio/prepared/f8d6c4ed5e618f688e75e81d4ef58f78e53e8cfc17851854e8ff89c2ae6fc112.mp3",
      "bytes": 131701,
      "text": "Slowly raise your affected arm forward and upward, reaching toward the target above. Keep your shoulder relaxed and avoid hiking it up."
    },
    {
      "group": "assessment:upper_limb",
      "key": "3ad06b65d5494b7d257153abfa709f060ec58db838046be2034c546b6f528cd9",
      "url": "/audio/prepared/3ad06b65d5494b7d257153abfa709f060ec58db838046be2034c546b6f528cd9.mp3",
      "bytes": 58976,
      "text": "Hold your affected arm steadily at the upper target for a moment."
    },
    {
      "group": "assessment:upper_limb",
      "key": "15029b464ff1b183cf5e5d8ee3480c0507ada12e1651f8b1b9404050c86a010b",
      "url": "/audio/prepared/15029b464ff1b183cf5e5d8ee3480c0507ada12e1651f8b1b9404050c86a010b.mp3",
      "bytes": 100772,
      "text": "Beautiful. Now, gently lower your affected hand back to the same place on your lap."
    },
    {
      "group": "assessment:upper_limb",
      "key": "6d2c36b822e00390f685f478cb7368635e3cc85730e2b5ba28c241eb1b3832ce",
      "url": "/audio/prepared/6d2c36b822e00390f685f478cb7368635e3cc85730e2b5ba28c241eb1b3832ce.mp3",
      "bytes": 69425,
      "text": "Reach with your affected hand toward the marked lightweight cup on the table."
    },
    {
      "group": "assessment:upper_limb",
      "key": "bd65ad435a81984b12b8f6540f18e91996a8303825b63c935878f07999350856",
      "url": "/audio/prepared/bd65ad435a81984b12b8f6540f18e91996a8303825b63c935878f07999350856.mp3",
      "bytes": 76112,
      "text": "Open your hand around the cup, then close your fingers to form a secure grasp."
    },
    {
      "group": "assessment:upper_limb",
      "key": "c05658a1a9a50752a1749ef100e6b1e01ba66d1d40d62bc9047ce28a3103b934",
      "url": "/audio/prepared/c05658a1a9a50752a1749ef100e6b1e01ba66d1d40d62bc9047ce28a3103b934.mp3",
      "bytes": 53960,
      "text": "Lift the cup slightly and hold it steadily for a moment."
    },
    {
      "group": "assessment:upper_limb",
      "key": "cb731683c15dee61c597beffc26b1e2588e79012b5680cf573fc72d9cfa14772",
      "url": "/audio/prepared/cb731683c15dee61c597beffc26b1e2588e79012b5680cf573fc72d9cfa14772.mp3",
      "bytes": 68589,
      "text": "Keep holding the cup and carefully move it across to the target on the other side."
    },
    {
      "group": "assessment:upper_limb",
      "key": "53ca40dd9b3bc897fe6f4fa524ac10cfb434cf051d6a47d97d993e88a20c72ab",
      "url": "/audio/prepared/53ca40dd9b3bc897fe6f4fa524ac10cfb434cf051d6a47d97d993e88a20c72ab.mp3",
      "bytes": 46437,
      "text": "Place the cup steadily inside the target area."
    },
    {
      "group": "assessment:upper_limb",
      "key": "3c8d98e17674d663c42148a4108173192be6b6605262908ce062a603a023e31c",
      "url": "/audio/prepared/3c8d98e17674d663c42148a4108173192be6b6605262908ce062a603a023e31c.mp3",
      "bytes": 72351,
      "text": "Now open your fingers, release the cup, and move your empty hand away."
    },
    {
      "group": "assessment:upper_limb",
      "key": "1e84b7316c3e06548bd3fadae8fd450b9c85946d76b5511cdfb57e3bbbe39a6b",
      "url": "/audio/prepared/1e84b7316c3e06548bd3fadae8fd450b9c85946d76b5511cdfb57e3bbbe39a6b.mp3",
      "bytes": 79038,
      "text": "Raise your affected hand to chest height and hold it where the camera can see it clearly."
    },
    {
      "group": "assessment:upper_limb",
      "key": "b389f5a4ca7ff7ca1696ec400504c8f365cfbf62ef2a03c8a2090917210a587a",
      "url": "/audio/prepared/b389f5a4ca7ff7ca1696ec400504c8f365cfbf62ef2a03c8a2090917210a587a.mp3",
      "bytes": 56050,
      "text": "Open your affected hand as wide as you comfortably can."
    },
    {
      "group": "assessment:upper_limb",
      "key": "b050831d56bc4f80465a74429cfd31835f4a46cd0a340ef819832b36470bff05",
      "url": "/audio/prepared/b050831d56bc4f80465a74429cfd31835f4a46cd0a340ef819832b36470bff05.mp3",
      "bytes": 36824,
      "text": "Keep your hand open and steady for a moment."
    },
    {
      "group": "assessment:upper_limb",
      "key": "c9214a884d4711d918598c150375c90cedb336f2b420d2230cb9b4d24d0896b3",
      "url": "/audio/prepared/c9214a884d4711d918598c150375c90cedb336f2b420d2230cb9b4d24d0896b3.mp3",
      "bytes": 79038,
      "text": "Now slowly close your fingers as if forming a secure grasp around a soft ball."
    },
    {
      "group": "assessment:upper_limb",
      "key": "ff1d827f104078c8d14fe35d4403d7c8267fe12cd84d62f5867a856329440b60",
      "url": "/audio/prepared/ff1d827f104078c8d14fe35d4403d7c8267fe12cd84d62f5867a856329440b60.mp3",
      "bytes": 36824,
      "text": "Hold the grasp steadily for a moment."
    },
    {
      "group": "assessment:upper_limb",
      "key": "886b0bc9153114d58d572b93bc30ec5fa547d6bf9d10ecf723a09ae5752a3a97",
      "url": "/audio/prepared/886b0bc9153114d58d572b93bc30ec5fa547d6bf9d10ecf723a09ae5752a3a97.mp3",
      "bytes": 47273,
      "text": "Open your fingers again to release the grasp."
    },
    {
      "group": "assessment:upper_limb",
      "key": "66535dce7f01ea35d16e7b6f9c2ec5497262b7bd6c02c76ac2d05446baa3c4d0",
      "url": "/audio/prepared/66535dce7f01ea35d16e7b6f9c2ec5497262b7bd6c02c76ac2d05446baa3c4d0.mp3",
      "bytes": 56886,
      "text": "Hold your hand up in front of your chest, palm facing you."
    },
    {
      "group": "assessment:upper_limb",
      "key": "5e5af4c6bf60b5f72dd0f032ef7982756ce3539525f9f0bec1b73aa570944cd9",
      "url": "/audio/prepared/5e5af4c6bf60b5f72dd0f032ef7982756ce3539525f9f0bec1b73aa570944cd9.mp3",
      "bytes": 94084,
      "text": "Now, slowly touch the tip of your thumb to the tip of your index finger, as if picking up a small coin."
    },
    {
      "group": "assessment:upper_limb",
      "key": "79bffc753ddcfc6655f3aabf40c7de66ba1df58c697f1705d39846aee7d468b0",
      "url": "/audio/prepared/79bffc753ddcfc6655f3aabf40c7de66ba1df58c697f1705d39846aee7d468b0.mp3",
      "bytes": 45601,
      "text": "Keep the thumb-index pinch steady for a moment."
    },
    {
      "group": "assessment:upper_limb",
      "key": "84b1089535d6b0f5e4d26f20c7b6f40928ce35de70892fdc5c3127d5d5096c44",
      "url": "/audio/prepared/84b1089535d6b0f5e4d26f20c7b6f40928ce35de70892fdc5c3127d5d5096c44.mp3",
      "bytes": 54378,
      "text": "Separate your thumb and index finger to release the pinch."
    },
    {
      "group": "assessment:upper_limb",
      "key": "626228a100359f0437c4761d54fbfd261dfa454616dff6355fa7ac93dee5c682",
      "url": "/audio/prepared/626228a100359f0437c4761d54fbfd261dfa454616dff6355fa7ac93dee5c682.mp3",
      "bytes": 95338,
      "text": "Our last task uses both hands together. Bring both hands up in front of you, around chest height."
    },
    {
      "group": "assessment:upper_limb",
      "key": "ce73cea4b28434a522ce295a9ab3a715584f36266687755a3138460659f419da",
      "url": "/audio/prepared/ce73cea4b28434a522ce295a9ab3a715584f36266687755a3138460659f419da.mp3",
      "bytes": 114564,
      "text": "Pretend you are holding the two corners of a towel. Bring both hands inward together until the corners meet in front of you."
    },
    {
      "group": "assessment:upper_limb",
      "key": "ffb2a4594bf297477f2768ed762631e11226837cca42f6b8e770b3b2f24bfa95",
      "url": "/audio/prepared/ffb2a4594bf297477f2768ed762631e11226837cca42f6b8e770b3b2f24bfa95.mp3",
      "bytes": 66499,
      "text": "Now move both hands outward again while keeping them at the same height."
    },
    {
      "group": "assessment:upper_limb",
      "key": "fb414d00617b3660d044d4aafb1d37160a9e0b1e138d1f77a21121e8819f879a",
      "url": "/audio/prepared/fb414d00617b3660d044d4aafb1d37160a9e0b1e138d1f77a21121e8819f879a.mp3",
      "bytes": 58976,
      "text": "Magnificent work. Lower both hands together and relax."
    },
    {
      "group": "assessment:hand",
      "key": "2733f7a733c5177b74caf9732345c59b400f321560bddd15d995873bb0d89e89",
      "url": "/audio/prepared/2733f7a733c5177b74caf9732345c59b400f321560bddd15d995873bb0d89e89.mp3",
      "bytes": 169735,
      "text": "We will begin the hand function package. Bring your affected hand up in front of your chest, with your palm facing the camera. If your hand is already open, keep it open and steady."
    },
    {
      "group": "assessment:hand",
      "key": "bb54917d6f0bf8f8f6006766d880fb86ef20a84ee1dd33e81577d2228cc6ca0e",
      "url": "/audio/prepared/bb54917d6f0bf8f8f6006766d880fb86ef20a84ee1dd33e81577d2228cc6ca0e.mp3",
      "bytes": 127939,
      "text": "Now slowly open your fingers as wide as you comfortably can, or keep them open if they are already open. Hold your palm open and steady."
    },
    {
      "group": "assessment:hand",
      "key": "8f807579c7b65d498f7f98c108f2e82d62e00adc3f8ae7d356fe06c4ede49f19",
      "url": "/audio/prepared/8f807579c7b65d498f7f98c108f2e82d62e00adc3f8ae7d356fe06c4ede49f19.mp3",
      "bytes": 72351,
      "text": "Good. Relax your hand and lower it to the same place on your lap."
    },
    {
      "group": "assessment:hand",
      "key": "1c52e4199cd0e0db1ee8a3704c031b4786752e83267367220720f3c167fb156e",
      "url": "/audio/prepared/1c52e4199cd0e0db1ee8a3704c031b4786752e83267367220720f3c167fb156e.mp3",
      "bytes": 59812,
      "text": "Hold your hand up again. Start with your hand open if you can."
    },
    {
      "group": "assessment:hand",
      "key": "52c6fc4b0e506183192951c81a42e72d29c67c9afb2f8fdecae32a747f212a71",
      "url": "/audio/prepared/52c6fc4b0e506183192951c81a42e72d29c67c9afb2f8fdecae32a747f212a71.mp3",
      "bytes": 93248,
      "text": "Slowly close your fingers into a fist. Take your time, then hold the fist for a moment."
    },
    {
      "group": "assessment:hand",
      "key": "d8955baa878568558c9743408c1170513c1e84ac83c2f6a5c2e9601ac2813d07",
      "url": "/audio/prepared/d8955baa878568558c9743408c1170513c1e84ac83c2f6a5c2e9601ac2813d07.mp3",
      "bytes": 25539,
      "text": "Now relax your hand again."
    },
    {
      "group": "assessment:hand",
      "key": "488232060f48c67ba8718e2b820077acfeb1b5bc45488a64ef9922b339249fb8",
      "url": "/audio/prepared/488232060f48c67ba8718e2b820077acfeb1b5bc45488a64ef9922b339249fb8.mp3",
      "bytes": 120834,
      "text": "This is an advanced grasp task. Reach toward your light object with the AxonAI marker facing the camera."
    },
    {
      "group": "assessment:hand",
      "key": "0521dbaffb0814fb1c05525d88b9a67006990fab2d906be5d9ee3265c1d6e050",
      "url": "/audio/prepared/0521dbaffb0814fb1c05525d88b9a67006990fab2d906be5d9ee3265c1d6e050.mp3",
      "bytes": 68589,
      "text": "Close your hand around the object and lift it slightly. Keep it steady."
    },
    {
      "group": "assessment:hand",
      "key": "a474c3385f3355ab2cfc0bf47cb715b6e5a7341f0b94f11b08025986d76c4743",
      "url": "/audio/prepared/a474c3385f3355ab2cfc0bf47cb715b6e5a7341f0b94f11b08025986d76c4743.mp3",
      "bytes": 35152,
      "text": "Gently place the object back down."
    },
    {
      "group": "assessment:hand",
      "key": "fea1953f97db6f2f77653921ec33b97c07c70977c8fd56a21a3eccd63f0b6d68",
      "url": "/audio/prepared/fea1953f97db6f2f77653921ec33b97c07c70977c8fd56a21a3eccd63f0b6d68.mp3",
      "bytes": 50199,
      "text": "Hold the marked object with your affected hand."
    },
    {
      "group": "assessment:hand",
      "key": "004eb8a6e7b8a8574092f81e603ee7ae2ccfd461e330d739e5ceb2bafcaee0cd",
      "url": "/audio/prepared/004eb8a6e7b8a8574092f81e603ee7ae2ccfd461e330d739e5ceb2bafcaee0cd.mp3",
      "bytes": 70261,
      "text": "Move the object to the target area, then open your fingers and let go."
    },
    {
      "group": "assessment:hand",
      "key": "f927417ce21d0a807febd778f02500bdf58c4472e13f9f22978d27eaf0d7fef7",
      "url": "/audio/prepared/f927417ce21d0a807febd778f02500bdf58c4472e13f9f22978d27eaf0d7fef7.mp3",
      "bytes": 38914,
      "text": "Move your empty hand away from the object."
    },
    {
      "group": "assessment:hand",
      "key": "8375c52954aef38f53a1c0567f428719e6ce0bc9810931778b3a2367e7079621",
      "url": "/audio/prepared/8375c52954aef38f53a1c0567f428719e6ce0bc9810931778b3a2367e7079621.mp3",
      "bytes": 56050,
      "text": "Place your forearm comfortably, and bring your hand into view."
    },
    {
      "group": "assessment:hand",
      "key": "39e7112df35b667589a62be17fb57d442c175705381d7389b1589dd5cbfbd620",
      "url": "/audio/prepared/39e7112df35b667589a62be17fb57d442c175705381d7389b1589dd5cbfbd620.mp3",
      "bytes": 76112,
      "text": "Lift your wrist gently and hold it steady. Try to keep your fingers relaxed."
    },
    {
      "group": "assessment:hand",
      "key": "8ca1bb951524d6b88de57c1a06ee83115412c0da1e1097ca3967d573d5509301",
      "url": "/audio/prepared/8ca1bb951524d6b88de57c1a06ee83115412c0da1e1097ca3967d573d5509301.mp3",
      "bytes": 40586,
      "text": "Relax your wrist and lower your hand."
    },
    {
      "group": "assessment:lower_limb",
      "key": "71f07cfd9de902b1cd544c6931352491a09726f5e4ca4a63b751627280506772",
      "url": "/audio/prepared/71f07cfd9de902b1cd544c6931352491a09726f5e4ca4a63b751627280506772.mp3",
      "bytes": 75276,
      "text": "Sit well back in a stable chair with both feet on the floor. Keep your trunk upright."
    },
    {
      "group": "assessment:lower_limb",
      "key": "b119540b143a86a26cd6f91716a4f5a2e7a88b4745852900529ad6b11e4d59ee",
      "url": "/audio/prepared/b119540b143a86a26cd6f91716a4f5a2e7a88b4745852900529ad6b11e4d59ee.mp3",
      "bytes": 94502,
      "text": "Slowly straighten the affected knee as far as you comfortably can. Keep your thigh on the chair."
    },
    {
      "group": "assessment:lower_limb",
      "key": "e518857f5361ecdc753b82a32aecea785fca1c679ebf436104bd7045a455c16a",
      "url": "/audio/prepared/e518857f5361ecdc753b82a32aecea785fca1c679ebf436104bd7045a455c16a.mp3",
      "bytes": 35988,
      "text": "Hold the lower leg steady for a moment."
    },
    {
      "group": "assessment:lower_limb",
      "key": "496375dff98a940734f04c7db031660604631e25d85cdd71c37a97e88a1fb79b",
      "url": "/audio/prepared/496375dff98a940734f04c7db031660604631e25d85cdd71c37a97e88a1fb79b.mp3",
      "bytes": 37660,
      "text": "Slowly lower the foot back to the floor."
    },
    {
      "group": "assessment:lower_limb",
      "key": "9b09bd6a85b6cc705f26c9a2a5ad5b03c8ec9bf15fa0875f1dcce0cc68b39183",
      "url": "/audio/prepared/9b09bd6a85b6cc705f26c9a2a5ad5b03c8ec9bf15fa0875f1dcce0cc68b39183.mp3",
      "bytes": 53124,
      "text": "Keep the affected heel on the floor and relax the toes."
    },
    {
      "group": "assessment:lower_limb",
      "key": "a2acfade8ea77fb38065e4dc7238839451fc137071be1a8fba95e06bbdd09564",
      "url": "/audio/prepared/a2acfade8ea77fb38065e4dc7238839451fc137071be1a8fba95e06bbdd09564.mp3",
      "bytes": 67753,
      "text": "Lift the front of the affected foot and toes while keeping the heel down."
    },
    {
      "group": "assessment:lower_limb",
      "key": "64248a1161656b06ee2c85d495ae3df4b9862551e4ad9d1083f002d24159a6d5",
      "url": "/audio/prepared/64248a1161656b06ee2c85d495ae3df4b9862551e4ad9d1083f002d24159a6d5.mp3",
      "bytes": 40586,
      "text": "Lower the toes slowly back to the floor."
    },
    {
      "group": "assessment:lower_limb",
      "key": "04a9c1f7d5af101395343475016dbd35e816357915f01fa134c7c603dd448bd2",
      "url": "/audio/prepared/04a9c1f7d5af101395343475016dbd35e816357915f01fa134c7c603dd448bd2.mp3",
      "bytes": 102862,
      "text": "Place both feet under your knees. Move toward the front of the chair and keep your support within reach."
    },
    {
      "group": "assessment:lower_limb",
      "key": "92123119d28a36d5bc936ab07047e1f29b8555c687536ffe0be521dcdad754a3",
      "url": "/audio/prepared/92123119d28a36d5bc936ab07047e1f29b8555c687536ffe0be521dcdad754a3.mp3",
      "bytes": 81964,
      "text": "Lean your trunk forward, push through both feet, and stand using the support as needed."
    },
    {
      "group": "assessment:lower_limb",
      "key": "7ee65b815468b78db0d9e62d4ab9a7d1b21266106c22a09da314daec4fceb072",
      "url": "/audio/prepared/7ee65b815468b78db0d9e62d4ab9a7d1b21266106c22a09da314daec4fceb072.mp3",
      "bytes": 53124,
      "text": "Stand tall with the support and keep both knees steady."
    },
    {
      "group": "assessment:lower_limb",
      "key": "11e036347df585234420a9aa26de443c466889ef20b3c1ca10f41cf7dbab2888",
      "url": "/audio/prepared/11e036347df585234420a9aa26de443c466889ef20b3c1ca10f41cf7dbab2888.mp3",
      "bytes": 54378,
      "text": "Reach back for the chair and sit down slowly with control."
    },
    {
      "group": "assessment:lower_limb",
      "key": "50b387ec1949c0176d19b1dda47dc5efd40df1190c4b84a24b51cfe18f780094",
      "url": "/audio/prepared/50b387ec1949c0176d19b1dda47dc5efd40df1190c4b84a24b51cfe18f780094.mp3",
      "bytes": 69425,
      "text": "Stand with your support and settle your weight evenly before stepping."
    },
    {
      "group": "assessment:lower_limb",
      "key": "8312f0f4eb65494533562866646dbc323bf18bcbad0d72b1548e4c0ff2623ed0",
      "url": "/audio/prepared/8312f0f4eb65494533562866646dbc323bf18bcbad0d72b1548e4c0ff2623ed0.mp3",
      "bytes": 87397,
      "text": "Move weight onto the stronger leg and step the affected foot forward a short distance."
    },
    {
      "group": "assessment:lower_limb",
      "key": "3e2fcc566881b71074172c0ccf2ac6e4311033f92bc8abd678abb18cba21bfc7",
      "url": "/audio/prepared/3e2fcc566881b71074172c0ccf2ac6e4311033f92bc8abd678abb18cba21bfc7.mp3",
      "bytes": 61902,
      "text": "Bring the affected foot back beside the other foot with control."
    },
    {
      "group": "assessment:lower_limb",
      "key": "76ea378f7c230e38ec86f96c28050acc4edd49e488f44d4df9a369aa5e81a345",
      "url": "/audio/prepared/76ea378f7c230e38ec86f96c28050acc4edd49e488f44d4df9a369aa5e81a345.mp3",
      "bytes": 74022,
      "text": "Stand with support, feet apart, and pause until you feel steady."
    },
    {
      "group": "assessment:lower_limb",
      "key": "3adcb36fe27d3e7b82d563c269958fb1bd4ce223f3c409891b7efea4ea8d8dfb",
      "url": "/audio/prepared/3adcb36fe27d3e7b82d563c269958fb1bd4ce223f3c409891b7efea4ea8d8dfb.mp3",
      "bytes": 53960,
      "text": "Lift the affected knee, then place the foot down slowly."
    },
    {
      "group": "assessment:lower_limb",
      "key": "86ba09bb0785588e7ef799ae8839b9793849f05da09906957da4c96e0d060baf",
      "url": "/audio/prepared/86ba09bb0785588e7ef799ae8839b9793849f05da09906957da4c96e0d060baf.mp3",
      "bytes": 74440,
      "text": "Lift the other knee, then place the foot down. Keep your trunk centered."
    },
    {
      "group": "assessment:balance",
      "key": "af64c187f6a6c8a14843762d8e6fa827223a2535e98045ad280f42fd341f4747",
      "url": "/audio/prepared/af64c187f6a6c8a14843762d8e6fa827223a2535e98045ad280f42fd341f4747.mp3",
      "bytes": 67335,
      "text": "Sit with both feet supported and place your hands on your thighs."
    },
    {
      "group": "assessment:balance",
      "key": "059ec3394f63181c7cbe12967b41464062df9a2a4ab54231192b446dc9676ee6",
      "url": "/audio/prepared/059ec3394f63181c7cbe12967b41464062df9a2a4ab54231192b446dc9676ee6.mp3",
      "bytes": 84889,
      "text": "Let go of external support if your therapist says it is safe. Sit still and upright."
    },
    {
      "group": "assessment:balance",
      "key": "3450d6e191fd473478554e55221b18a82c99cb73cbc4b80162036f43a160b5b4",
      "url": "/audio/prepared/3450d6e191fd473478554e55221b18a82c99cb73cbc4b80162036f43a160b5b4.mp3",
      "bytes": 48527,
      "text": "Sit upright in the middle with both feet supported."
    },
    {
      "group": "assessment:balance",
      "key": "8cee5806e6166a60cb9c9662793f06ee36a9decb29e473337794c3d6f18ea6b1",
      "url": "/audio/prepared/8cee5806e6166a60cb9c9662793f06ee36a9decb29e473337794c3d6f18ea6b1.mp3",
      "bytes": 67753,
      "text": "Reach the affected arm slightly to the side while keeping both hips on the seat."
    },
    {
      "group": "assessment:balance",
      "key": "561195311a15e8502d50158d3ae611463c64bdc76a098147972c46fd18e4720d",
      "url": "/audio/prepared/561195311a15e8502d50158d3ae611463c64bdc76a098147972c46fd18e4720d.mp3",
      "bytes": 51035,
      "text": "Return slowly to the middle and sit upright again."
    },
    {
      "group": "assessment:balance",
      "key": "3b7c0ba92de5b508301d03d6c28d821a61be95c408486408b41a9cb4037559c9",
      "url": "/audio/prepared/3b7c0ba92de5b508301d03d6c28d821a61be95c408486408b41a9cb4037559c9.mp3",
      "bytes": 70261,
      "text": "Stand using the fixed support and place both feet comfortably apart."
    },
    {
      "group": "assessment:balance",
      "key": "2545dcdda0a96cc3d3b4d51bcf8914c2a49924973729f07e3857f58725644bce",
      "url": "/audio/prepared/2545dcdda0a96cc3d3b4d51bcf8914c2a49924973729f07e3857f58725644bce.mp3",
      "bytes": 61066,
      "text": "Keep both knees steady and hold the supported standing position."
    },
    {
      "group": "assessment:balance",
      "key": "74f55eb4d9b640fe5fac063f5e3904bb6d17470abb7d0e4b7d353297db251b5e",
      "url": "/audio/prepared/74f55eb4d9b640fe5fac063f5e3904bb6d17470abb7d0e4b7d353297db251b5e.mp3",
      "bytes": 47273,
      "text": "Stand with support and settle your weight in the middle."
    },
    {
      "group": "assessment:balance",
      "key": "89862cc521007da8a148bdc277406b3d78a3ec53d2ab616eb59e9ed61a961516",
      "url": "/audio/prepared/89862cc521007da8a148bdc277406b3d78a3ec53d2ab616eb59e9ed61a961516.mp3",
      "bytes": 78202,
      "text": "Shift your pelvis slowly toward the affected leg while keeping both feet down."
    },
    {
      "group": "assessment:balance",
      "key": "df0074c5aed680748288945c11d5593f6cae69d37123f8268bffd13c20ee2011",
      "url": "/audio/prepared/df0074c5aed680748288945c11d5593f6cae69d37123f8268bffd13c20ee2011.mp3",
      "bytes": 45601,
      "text": "Return slowly to the middle and hold steady."
    },
    {
      "group": "assessment:balance",
      "key": "e4f11ab8ad4c43b6fb9cabb1e7c38a9fe70748661286c4c2cedefaaf604d99a9",
      "url": "/audio/prepared/e4f11ab8ad4c43b6fb9cabb1e7c38a9fe70748661286c4c2cedefaaf604d99a9.mp3",
      "bytes": 68589,
      "text": "Stand with support and place the affected foot a short step forward."
    },
    {
      "group": "assessment:balance",
      "key": "88a66ef28c9534f93e681b67a047513b89488781392f0ca6724a16a0d08601f1",
      "url": "/audio/prepared/88a66ef28c9534f93e681b67a047513b89488781392f0ca6724a16a0d08601f1.mp3",
      "bytes": 71097,
      "text": "Keep the support and hold this step position without moving your feet."
    },
    {
      "group": "assessment:balance",
      "key": "59c4a0ba762b8bf45cb49b87ec08c9cfa9a5269e63d9e7bd32ea2536555fd038",
      "url": "/audio/prepared/59c4a0ba762b8bf45cb49b87ec08c9cfa9a5269e63d9e7bd32ea2536555fd038.mp3",
      "bytes": 66499,
      "text": "Bring the affected foot back beside the other foot and settle in the middle."
    }
  ]
}
